# ============================================================================
# FOSS Club KIET — Admin & Supabase Configuration
# Copy this file to .env.local and fill in your values.
# ============================================================================

# 1. Admin Login Credentials (used at /admin)
# Defaults locally to admin / fossc2026 if not set
ADMIN_USERNAME=admin
ADMIN_PASSWORD=fossc2026
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret-string

# 2. Supabase Connection (Optional locally, Recommended for Vercel/Production)
# Run supabase/schema.sql in your Supabase SQL Editor first!
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
